{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
  ],
  "labels": [
    "t: dependencies",
  ],
  "reviewers": [
    "0utplay",
    "derklaro",
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
      ],
      "groupName": "github actions",
    },
    {
      "matchUpdateTypes": [
        "patch",
      ],
      "matchPackageNames": [
        "*",
        "!gradle",
      ],
      "groupName": "all dependencies with patch changes",
    },
    {
      "description": "Dependencies whose updates shouldn't be done automatically",
      matchPackageNames: [
        "org.jetbrains.kotlin.jvm", // should be aligned with the version bundled in gradle
      ],
      enabled: false,
    }
  ],
  "prHourlyLimit": 10,
  "rebaseWhen": "conflicted",
  "rebaseLabel": "s: rebase",
  "commitMessagePrefix": "chore: ",
  "commitMessageAction": "update",
}
